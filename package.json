{
  "name": "foodassopos",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "package": "electron-packager .",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "electron-dev": "concurrently \"yarn start\" \"yarn electron\"",
    "electron": "electron .",
    "clean": "rimraf dist",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.foodasso.foodassopos",
    "productName": "foodasso",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "build/**/*",
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/foodasso.svg"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/foodasso.svg"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/babel__core": "^7.20.5",
    "@types/jest": "^29.5.12",
    "@types/node": "18.11.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "date-fns": "^3.6.0",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.39",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-checkbox-tree": "^1.8.0",
    "react-dom": "^18.3.1",
    "react-icons": "^5.2.1",
    "react-router-dom": "^6.24.1",
    "react-scripts": "5.0.1",
    "react-select": "^5.0.1",
    "rimraf": "6.0.1",
    "sass": "^1.77.8",
    "sass-loader": "^16.0.0",
    "stylelint-config-tailwindcss": "^0.0.7",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.4",
    "wait-on": "^7.2.0",
    "web-vitals": "^4.2.2"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "@types/redux-persist": "^4.3.1",
    "@vovkasm/redux-persist": "^4.10.1",
    "axios": "^1.7.7",
    "basic-react-steps": "^0.2.3",
    "chart.js": "^4.4.6",
    "dayjs": "^1.11.13",
    "react-hot-toast": "^2.4.1",
    "react-redux": "^9.1.2",
    "react-toastify": "^10.0.6",
    "redux-persist": "^6.0.0",
    "yarn": "^1.22.22"
  }
}
